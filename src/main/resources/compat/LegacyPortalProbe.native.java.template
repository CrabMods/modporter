package @PACKAGE@;

import java.util.Optional;
import javax.annotation.Nullable;
import net.minecraft.BlockUtil;
import net.minecraft.core.BlockPos;
import net.minecraft.core.Direction;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.server.level.TicketType;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityDimensions;
import net.minecraft.world.level.ChunkPos;
import net.minecraft.world.level.Level;
import net.minecraft.world.level.block.state.BlockState;
import net.minecraft.world.level.block.state.properties.BlockStateProperties;
import net.minecraft.world.level.border.WorldBorder;
import net.minecraft.world.level.dimension.DimensionType;
import net.minecraft.world.level.levelgen.Heightmap;
import net.minecraft.world.level.portal.PortalForcer;
import net.minecraft.world.level.portal.PortalShape;
import net.minecraft.world.phys.Vec3;

/**
 * The removed 1.20.1 Entity portal probe algorithm.
 *
 * <p>This helper searches existing portals only. It retains the old radius-three portal ticket
 * side effect and never creates a portal or supplies a post-transition callback.</p>
 */
public final class LegacyPortalProbe {
    private LegacyPortalProbe() {
    }

    /**
     * Exact mapped 1.20.1 Entity#findDimensionEntryPoint behavior for a non-player probe.
     */
    @Nullable
    public static PortalInfo findDimensionEntryPoint(
        Entity entity,
        @Nullable BlockPos portalEntrancePos,
        ServerLevel destination
    ) {
        boolean fromEndToOverworld =
            entity.level().dimension() == Level.END && destination.dimension() == Level.OVERWORLD;
        boolean toEnd = destination.dimension() == Level.END;
        if (!fromEndToOverworld && !toEnd) {
            boolean toNether = destination.dimension() == Level.NETHER;
            if (entity.level().dimension() != Level.NETHER && !toNether) {
                return null;
            }

            WorldBorder worldBorder = destination.getWorldBorder();
            double scale = DimensionType.getTeleportationScale(
                entity.level().dimensionType(),
                destination.dimensionType()
            );
            BlockPos exitPos = worldBorder.clampToBounds(
                entity.getX() * scale,
                entity.getY(),
                entity.getZ() * scale
            );
            return findExitPortal(destination, exitPos, toNether, worldBorder)
                .map(rectangle -> createPortalInfo(
                    destination,
                    rectangle,
                    entity,
                    portalEntrancePos
                ))
                .orElse(null);
        }

        BlockPos destinationPos = toEnd
            ? ServerLevel.END_SPAWN_POINT
            : destination.getHeightmapPos(
                Heightmap.Types.MOTION_BLOCKING_NO_LEAVES,
                destination.getSharedSpawnPos()
            );
        return new PortalInfo(
            new Vec3(
                destinationPos.getX() + 0.5,
                destinationPos.getY(),
                destinationPos.getZ() + 0.5
            ),
            entity.getDeltaMovement(),
            entity.getYRot(),
            entity.getXRot()
        );
    }

    private static Optional<BlockUtil.FoundRectangle> findExitPortal(
        ServerLevel destination,
        BlockPos exitPos,
        boolean isNether,
        WorldBorder worldBorder
    ) {
        return destination.getPortalForcer()
            .findClosestPortalPosition(exitPos, isNether, worldBorder)
            .map(portalPos -> {
                destination.getChunkSource().addRegionTicket(
                    TicketType.PORTAL,
                    new ChunkPos(portalPos),
                    PortalForcer.TICKET_RADIUS,
                    portalPos
                );
                BlockState portalState = destination.getBlockState(portalPos);
                return BlockUtil.getLargestRectangleAround(
                    portalPos,
                    portalState.getValue(BlockStateProperties.HORIZONTAL_AXIS),
                    21,
                    Direction.Axis.Y,
                    21,
                    candidate -> destination.getBlockState(candidate) == portalState
                );
            });
    }

    private static PortalInfo createPortalInfo(
        ServerLevel destination,
        BlockUtil.FoundRectangle destinationRectangle,
        Entity entity,
        BlockPos portalEntrancePos
    ) {
        BlockState entranceState = entity.level().getBlockState(portalEntrancePos);
        Direction.Axis entranceAxis;
        Vec3 relativePosition;
        if (entranceState.hasProperty(BlockStateProperties.HORIZONTAL_AXIS)) {
            entranceAxis = entranceState.getValue(BlockStateProperties.HORIZONTAL_AXIS);
            BlockUtil.FoundRectangle entranceRectangle = BlockUtil.getLargestRectangleAround(
                portalEntrancePos,
                entranceAxis,
                21,
                Direction.Axis.Y,
                21,
                candidate -> entity.level().getBlockState(candidate) == entranceState
            );
            relativePosition = entity.getRelativePortalPosition(entranceAxis, entranceRectangle);
        } else {
            entranceAxis = Direction.Axis.X;
            relativePosition = new Vec3(0.5, 0.0, 0.0);
        }
        return createPortalInfo(
            destination,
            destinationRectangle,
            entranceAxis,
            relativePosition,
            entity,
            entity.getDeltaMovement(),
            entity.getYRot(),
            entity.getXRot()
        );
    }

    /**
     * Exact old PortalShape#createPortalInfo calculation, using target public APIs.
     */
    private static PortalInfo createPortalInfo(
        ServerLevel destination,
        BlockUtil.FoundRectangle rectangle,
        Direction.Axis entranceAxis,
        Vec3 offset,
        Entity entity,
        Vec3 speed,
        float yRot,
        float xRot
    ) {
        BlockPos minCorner = rectangle.minCorner;
        BlockState destinationState = destination.getBlockState(minCorner);
        Direction.Axis destinationAxis = destinationState
            .getOptionalValue(BlockStateProperties.HORIZONTAL_AXIS)
            .orElse(Direction.Axis.X);
        double width = rectangle.axis1Size;
        double height = rectangle.axis2Size;
        EntityDimensions dimensions = entity.getDimensions(entity.getPose());
        int rotation = entranceAxis == destinationAxis ? 0 : 90;
        Vec3 rotatedSpeed = entranceAxis == destinationAxis
            ? speed
            : new Vec3(speed.z, speed.y, -speed.x);
        double horizontal = dimensions.width() / 2.0
            + (width - dimensions.width()) * offset.x();
        double vertical = (height - dimensions.height()) * offset.y();
        double depth = 0.5 + offset.z();
        boolean destinationIsX = destinationAxis == Direction.Axis.X;
        Vec3 position = new Vec3(
            minCorner.getX() + (destinationIsX ? horizontal : depth),
            minCorner.getY() + vertical,
            minCorner.getZ() + (destinationIsX ? depth : horizontal)
        );
        Vec3 collisionFree = PortalShape.findCollisionFreePosition(
            position,
            destination,
            entity,
            dimensions
        );
        return new PortalInfo(collisionFree, rotatedSpeed, yRot + rotation, xRot);
    }

}
