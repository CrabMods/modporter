package @PACKAGE@;

import java.lang.ref.ReferenceQueue;
import java.lang.ref.WeakReference;
import java.util.HashMap;
import java.util.Map;
import net.minecraft.world.food.FoodProperties;

/** Retains 1.20.1-only fields for exact custom-codec round trips (generated by ModPorter). */
public final class LegacyFoodPropertiesCodec {
    private static final ReferenceQueue<FoodProperties> STALE = new ReferenceQueue<>();
    private static final Map<IdentityReference, LegacyFields> FIELDS = new HashMap<>();

    private LegacyFoodPropertiesCodec() {
    }

    public static synchronized void remember(
            FoodProperties properties,
            float saturationModifier,
            boolean meat,
            boolean fastFood) {
        discardStaleEntries();
        FIELDS.put(new IdentityReference(properties, STALE), new LegacyFields(saturationModifier, meat, fastFood));
    }

    public static synchronized boolean hasLegacyFields(FoodProperties properties) {
        return fields(properties) != null;
    }

    public static synchronized float saturationModifier(FoodProperties properties) {
        return requireFields(properties).saturationModifier();
    }

    public static synchronized boolean isMeat(FoodProperties properties) {
        return requireFields(properties).meat();
    }

    public static synchronized boolean isFastFood(FoodProperties properties) {
        return requireFields(properties).fastFood();
    }

    private static LegacyFields fields(FoodProperties properties) {
        discardStaleEntries();
        return FIELDS.get(new IdentityReference(properties, null));
    }

    private static LegacyFields requireFields(FoodProperties properties) {
        LegacyFields fields = fields(properties);
        if (fields == null) {
            throw new IllegalStateException("FoodProperties does not carry legacy codec fields");
        }
        return fields;
    }

    private static void discardStaleEntries() {
        IdentityReference reference;
        while ((reference = (IdentityReference) STALE.poll()) != null) {
            FIELDS.remove(reference);
        }
    }

    private record LegacyFields(float saturationModifier, boolean meat, boolean fastFood) {
    }

    private static final class IdentityReference extends WeakReference<FoodProperties> {
        private final int identityHash;

        private IdentityReference(FoodProperties properties, ReferenceQueue<FoodProperties> queue) {
            super(properties, queue);
            this.identityHash = System.identityHashCode(properties);
        }

        @Override
        public int hashCode() {
            return identityHash;
        }

        @Override
        public boolean equals(Object other) {
            if (this == other) {
                return true;
            }
            if (!(other instanceof IdentityReference reference)) {
                return false;
            }
            FoodProperties properties = get();
            return properties != null && properties == reference.get();
        }
    }
}
