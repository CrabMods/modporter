package @PACKAGE@.mixin;

import @PACKAGE@.LegacyPanoramaRendererBridge;
import net.minecraft.client.Minecraft;
import net.minecraft.client.renderer.CubeMap;
import net.minecraft.client.renderer.PanoramaRenderer;
import org.spongepowered.asm.mixin.Final;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Shadow;
import org.spongepowered.asm.mixin.Unique;

/** Restores the Forge 1.20.1 cube-map-only panorama entry point on the 1.21.1 renderer. */
@Mixin(PanoramaRenderer.class)
public abstract class LegacyPanoramaRendererMixin implements LegacyPanoramaRendererBridge {
    @Shadow
    @Final
    private Minecraft minecraft;

    @Shadow
    @Final
    private CubeMap cubeMap;

    @Shadow
    private float spin;

    @Shadow
    private float bob;

    @Override
    @Unique
    public void render(float partialTick, float fade) {
        this.modporter$renderLegacyPanoramaBase(partialTick, fade);
    }

    @Override
    @Unique
    public void modporter$renderLegacyPanoramaBase(float partialTick, float fade) {
        float step = (float) ((double) partialTick * this.minecraft.options.panoramaSpeed().get());
        this.spin = modporter$wrapLegacyPanorama(this.spin + step * 0.1F, 360.0F);
        this.bob = modporter$wrapLegacyPanorama(this.bob + step * 0.001F, 6.2831855F);
        this.cubeMap.render(this.minecraft, 10.0F, -this.spin, fade);
    }

    @Unique
    private static float modporter$wrapLegacyPanorama(float value, float maximum) {
        return value > maximum ? value - maximum : value;
    }
}
