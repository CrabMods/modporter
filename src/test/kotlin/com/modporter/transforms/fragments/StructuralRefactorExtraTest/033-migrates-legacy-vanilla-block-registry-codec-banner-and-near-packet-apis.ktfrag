        assertTrue(!misc.contains("RegistryAccess.EMPTY"))
        assertTrue(!misc.contains("ExtraCodecs.lazyInitializedCodec"))
        assertTrue(misc.contains("new Music(Sounds.MUSIC.getDelegate(), 20, 40, true)"))
